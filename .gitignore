# Local machine state & backups (never commit)
.local.json
.managed.json
.backup/
.autoupdate.log

# OS & editor junk
.DS_Store
Thumbs.db
desktop.ini

# Skill build/runtime caches
**/.godot/
**/*.uid
**/*.bak
**/*.bak-*
**/work/
**/node_modules/
**/__pycache__/
**/*.pyc

# Runtime logs & temp outputs inside mounted tool folders
**/*.log
**/*.log.done
**/job-runs/
**/thu-*.wav

# Caches do công cụ sinh ra (máy nào cũng tự dựng lại được)
**/.hyperframes/
**/.cache/
